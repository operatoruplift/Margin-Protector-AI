# Copy to .env.local. Only POST /api/shopify/discount reads these; the dashboard
# and the analysis routes use the bundled demo seed and need no configuration.
# Without both values (or after any Shopify error) the route returns a mock response.

# Store host, for example your-store.myshopify.com (no https://).
SHOPIFY_STORE_URL=

# Admin API access token with permission to create discounts. Server-only: never
# prefix it with NEXT_PUBLIC_ and never commit .env.local.
SHOPIFY_ACCESS_TOKEN=
